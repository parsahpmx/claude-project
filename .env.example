# Meter402 environment template.
#
# Copy to `.env` and fill in local values:   cp .env.example .env
#
# This file is the ONLY environment file committed to the repository, and it
# must never contain a real secret. Placeholder values below are deliberately
# non-functional. In production these are supplied by AWS Secrets Manager and
# injected at task start — see docs/KEY_MANAGEMENT.md.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# One of: local | development | staging | production
DEPLOY_ENV=local
LOG_LEVEL=debug
API_PORT=4000
API_HOST=127.0.0.1

# Public origin of the dashboard, used for CORS and callback URLs.
DASHBOARD_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# Matches the credentials in docker-compose.yml. Local only.
DATABASE_URL=postgresql://meter402:meter402@localhost:5432/meter402
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Generate real values with:  openssl rand -hex 32
# A short or default value causes the API to refuse to boot outside `local`.
AUTH_SECRET=replace_me_with_32_bytes_of_hex_from_openssl_rand_hex_32
API_KEY_HASH_PEPPER=replace_me_with_32_bytes_of_hex_from_openssl_rand_hex_32
WEBHOOK_SIGNING_SECRET=replace_me_with_32_bytes_of_hex_from_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Blockchain (Base + USDC)
# ---------------------------------------------------------------------------
# Base Sepolia (testnet) is chain 84532; Base mainnet is 8453.
# TEST-mode projects are pinned to the testnet chain and can never be pointed
# at mainnet — see packages/config and docs/PAYMENTS.md.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
# Optional but strongly recommended in production: an independent provider so a
# single RPC vendor cannot become a correctness dependency for payments.
SECONDARY_BASE_RPC_URL=

# USDC token contract for the configured chain.
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Number of confirmations required before a payment is CONFIRMED.
PAYMENT_CONFIRMATIONS_REQUIRED=3
# How long a payment challenge stays valid, in seconds.
PAYMENT_CHALLENGE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Observability (all optional; features degrade cleanly when unset)
# ---------------------------------------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
