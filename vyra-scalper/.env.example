# VYRA environment template.
#
# Copy to .env and fill in. NEVER commit .env — it is in .gitignore, and the CI secret
# scan fails the build on a credential-shaped literal in configs/.
#
# Every ${VAR} reference in configs/ resolves from this environment at load time. A
# reference with no value and no default raises at startup rather than resolving to an
# empty string, which would produce an anonymous connection attempt.

VYRA_ENV=development          # development | backtest | paper | staging | production

# --- storage -----------------------------------------------------------------------
POSTGRES_USER=vyra
POSTGRES_PASSWORD=
POSTGRES_DB=vyra
DATABASE_URL=postgresql://vyra:@localhost:5432/vyra
REDIS_URL=redis://localhost:6379/0

# --- Interactive Brokers (adapter NOT YET IMPLEMENTED) -------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                # 7497 paper, 7496 live
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# --- MetaTrader 5 (adapter NOT YET IMPLEMENTED) --------------------------------------
MT5_SERVER=
MT5_LOGIN=
MT5_PASSWORD=
MT5_TERMINAL_PATH=

# --- OANDA (adapter NOT YET IMPLEMENTED) ---------------------------------------------
OANDA_API_URL=https://api-fxpractice.oanda.com   # practice by default, never live
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# --- operations ----------------------------------------------------------------------
VYRA_OPERATOR=                # identity recorded on a kill-switch reset
VYRA_ALERT_WEBHOOK=

# --- API service ----------------------------------------------------------------------
# The API refuses to start without both of these. There is deliberately no default signing
# key and no default account: a service that comes up with a known secret is one whose
# tokens anyone can forge, and it would come up silently.
#
# Generate a secret with:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
VYRA_API_SECRET=
# name:password:ROLE,... with ROLE in VIEWER, TRADER, OPERATOR, ADMIN.
VYRA_API_USERS=
# Where the API's own durable state (the kill switch) is written. Kept out of the runs
# directory so runs can be mounted read-only.
VYRA_STATE_DIR=
# Origins allowed to call the API from a browser.
VYRA_CORS_ORIGINS=http://localhost:3000

# --- Durable and shared state ---------------------------------------------------------
# With VYRA_PG_DSN set the kill switch lives in PostgreSQL and propagates through Redis,
# so a halt reaches every process. Without it the switch falls back to a file, which is
# correct for a single process and is not correct for more than one.
#
# A configured store that cannot be reached is fatal at startup rather than a silent
# downgrade to the file: downgrading produces a service that looks like it has a global
# kill switch and does not.
VYRA_PG_DSN=
VYRA_REDIS_URL=

# Used by the storage test suite. Without them those tests skip themselves.
VYRA_TEST_PG_DSN=
VYRA_TEST_REDIS_URL=
