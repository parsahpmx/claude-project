# VYRA environment template.
#
# Copy to .env and fill in. NEVER commit .env — it is in .gitignore, and the CI secret
# scan fails the build on a credential-shaped literal in configs/.
#
# Every ${VAR} reference in configs/ resolves from this environment at load time. A
# reference with no value and no default raises at startup rather than resolving to an
# empty string, which would produce an anonymous connection attempt.

VYRA_ENV=development          # development | backtest | paper | staging | production

# --- storage -----------------------------------------------------------------------
POSTGRES_USER=vyra
POSTGRES_PASSWORD=
POSTGRES_DB=vyra
DATABASE_URL=postgresql://vyra:@localhost:5432/vyra
REDIS_URL=redis://localhost:6379/0

# --- Interactive Brokers (adapter NOT YET IMPLEMENTED) -------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                # 7497 paper, 7496 live
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# --- MetaTrader 5 (adapter NOT YET IMPLEMENTED) --------------------------------------
MT5_SERVER=
MT5_LOGIN=
MT5_PASSWORD=
MT5_TERMINAL_PATH=

# --- OANDA (adapter NOT YET IMPLEMENTED) ---------------------------------------------
OANDA_API_URL=https://api-fxpractice.oanda.com   # practice by default, never live
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# --- operations ----------------------------------------------------------------------
VYRA_OPERATOR=                # identity recorded on a kill-switch reset
VYRA_ALERT_WEBHOOK=
