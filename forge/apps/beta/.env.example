# FORGE Web Beta — environment
#
# Only NEXT_PUBLIC_* values reach the browser. The service role key is
# deliberately absent from this file: nothing in this app needs it, and adding
# it here would be the single most likely way to leak it.

NEXT_PUBLIC_SUPABASE_URL=https://xhbhlpegfnswhbodhbqp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vtB6Ympu2vJH1TDcCJc4nA_IaT1JoK1

# Optional. Comma-separated list of BETA OPTIONAL features to switch off in this
# environment, e.g. "clubs,events". Core features ignore this; post-beta ones
# stay off regardless.
FORGE_DISABLED_FEATURES=

# Map tiles. Defaults to the OpenStreetMap demo style, which is rate-limited and
# for development only — see docs/WEB_MAPS.md before pointing beta at it.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
