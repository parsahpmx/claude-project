# ---------------------------------------------------------------------------
# FORGE — environment
#
# Copy to .env. Everything here has a working default for local development;
# the production block is validated at boot and the process refuses to start
# if a development default has leaked into it.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API -------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated list of origins allowed to send credentialed requests.
WEB_ORIGIN=http://localhost:3000

# Signs cookies. Must be at least 32 characters, and must not start with
# "forge-development" in production.
COOKIE_SECRET=forge-development-cookie-secret-value-01

# How long a session stays valid. Default is 14 days.
SESSION_TTL_HOURS=336

# --- Database --------------------------------------------------------------
# Unset: PGlite (Postgres compiled to WebAssembly) runs in-process, so local
# development and CI need no database server at all.
#   memory://forge   in-memory, discarded on exit (the default)
#   ./.forge-data/pg persisted on disk between runs
FORGE_DATA_DIR=memory://forge

# Set this to a postgres:// URL and the same schema runs against a real server.
# Required in production.
# DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# Seed the demo dataset when the database is empty. Must be false in production.
AUTO_SEED=true

# --- Web -------------------------------------------------------------------
# Where the Next.js app proxies /api/* to. Keeping it same-origin is what makes
# the session cookie first-party in every environment.
FORGE_API_ORIGIN=http://localhost:4000
