{
  "name": "@meter402/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meter402 control plane. A modular monolith over Fastify.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@meter402/auth": "workspace:*",
    "@meter402/blockchain": "workspace:*",
    "@meter402/config": "workspace:*",
    "@meter402/database": "workspace:*",
    "@meter402/payments": "workspace:*",
    "@meter402/pricing": "workspace:*",
    "@meter402/shared": "workspace:*",
    "@meter402/x402": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "viem": "catalog:",
    "@x402/core": "catalog:",
    "@x402/evm": "catalog:"
  }
}
